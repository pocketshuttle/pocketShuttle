// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BusStatus {
  ENROUTE
  PARKED
}

enum StudentStatus {
  DROPPED
  PICKED
}

enum StudentAttendance {
  ABSENT
  PRESENT
}

enum StudentPresence {
  IN_BUS
  AT_SCHOOL
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          UserRole  @default(ADMIN)
  password      String?
  accounts      Account[]
  teachers      Teacher[]
  NewUser       NewUser[]
  Parent        Parent[]
  Student       Student[]

  @@map("users")
}

model NewUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  schoolId  String
  school    User     @relation(fields: [schoolId], references: [id])
  parent    Parent?  @relation(fields: [parentId], references: [id])
  parentId  String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Teacher {
  id            String    @id @default(cuid())
  teacherId     String    @map("teacher_id")
  role          String
  full_name     String?
  image         String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  password      String?
  phoneNumber   String?
  address       String
  schoolId      String
  school        User      @relation(fields: [schoolId], references: [id])
  busId         String?
  NewUser       NewUser[]
  Student       Student[]
}

model Parent {
  id            String    @id @default(cuid())
  parentId      String    @map("parent_id")
  role          String
  full_name     String?
  image         String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  password      String?
  phoneNumber   String?
  address       String?
  schoolId      String
  school        User      @relation(fields: [schoolId], references: [id])
  busId         String?
  NewUser       NewUser[]
  Student       Student[]
}

model Student {
  id         String            @id @default(cuid())
  parentId   String?           @map("parent_id")
  full_name  String?
  image      String?
  grade      String?
  gender     String?
  age        String?
  address    String?
  attendance StudentAttendance @default(ABSENT)
  status     StudentStatus     @default(DROPPED)
  presence   StudentPresence   @default(IN_BUS)
  parent     Parent?           @relation(fields: [parentId], references: [id])
  schoolId   String
  teacherId  String?
  teacher    Teacher?          @relation(fields: [teacherId], references: [id])
  school     User              @relation(fields: [schoolId], references: [id])
  busId      String?
}

model verificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model ResetPasswordToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}
