// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BusStatus {
  ENROUTE
  PARKED
}

enum StudentStatus {
  DROPPED
  PICKED
}

enum StudentAttendance {
  ABSENT
  PRESENT
}

enum StudentPresence {
  IN_BUS
  AT_SCHOOL
  ON_THE_WAY
  NONE
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          UserRole  @default(ADMIN)
  password      String?
  accounts      Account[]
  teachers      Teacher[]
  NewUser       NewUser[]
  Parent        Parent[]
  Student       Student[]
  Route         Route[]
  Buses         Buses[]
  Driver        Driver[]

  @@map("users")
}

model NewUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  schoolId  String
  school    User     @relation(fields: [schoolId], references: [id])
  parent    Parent?  @relation(fields: [parentId], references: [id])
  parentId  String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Teacher {
  id            String    @id @default(cuid())
  teacherId     String?   @map("teacher_id")
  role          String
  full_name     String?
  image         String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  password      String?
  phoneNumber   String?
  address       String
  schoolId      String?
  school        User?     @relation(fields: [schoolId], references: [id])
  busId         String?   @unique
  bus           Buses?    @relation(fields: [busId], references: [id])
  NewUser       NewUser[]
  Student       Student[]
}

model Driver {
  id            String    @id @default(cuid())
  driverId      String?   @map("driver_id")
  full_name     String
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  phoneNumber   String?
  image         String?
  address       String
  schoolId      String?
  busId         String?   @unique
  bus           Buses?    @relation(fields: [busId], references: [id])
  school        User?     @relation(fields: [schoolId], references: [id])
}

model Parent {
  id            String               @id @default(cuid())
  role          String
  full_name     String?
  image         String?
  email         String?              @unique
  emailVerified DateTime?            @map("email_verified")
  password      String?
  phoneNumber   String?
  address       String?
  schoolId      String
  school        User                 @relation(fields: [schoolId], references: [id])
  busId         String?
  NewUser       NewUser[]
  Student       Student[]
  notifications ParentNotification[]
}

model Student {
  id         String             @id @default(cuid())
  parentId   String?            @map("parent_id")
  full_name  String?
  image      String?
  grade      String?
  gender     String?
  age        Int?
  address    String?
  attendance StudentAttendance? @default(ABSENT)
  status     StudentStatus?     @default(DROPPED)
  presence   StudentPresence?   @default(NONE)
  parent     Parent?            @relation(fields: [parentId], references: [id])
  schoolId   String
  teacherId  String?
  teacher    Teacher?           @relation(fields: [teacherId], references: [id])
  school     User               @relation(fields: [schoolId], references: [id])
  busId      String?
  bus        Buses?             @relation("BusStudents", fields: [busId], references: [id])
  Buses      Buses[]
}

model Route {
  id                String  @id @default(cuid())
  route_name        String
  schoolId          String
  route_description String
  school            User    @relation(fields: [schoolId], references: [id])
  Buses             Buses[]
}

model Buses {
  id               String    @id @default(cuid())
  bus_product_name String
  bus_number       String    @unique
  seat_number      Int
  color            String?
  schoolId         String
  school           User      @relation(fields: [schoolId], references: [id])
  routeId          String
  studentId        String?
  students         Student[] @relation("BusStudents")
  route            Route?    @relation(fields: [routeId], references: [id])
  teacher          Teacher?
  Student          Student[]
  driver           Driver?

  @@map("buses")
}

model Notification {
  id               String               @id @default(cuid())
  notificationJson String
  parents          ParentNotification[]
}

model ParentNotification {
  id               String        @id @default(cuid())
  parentId         String?
  notificationId   String?
  parent           Parent?       @relation(fields: [parentId], references: [id])
  notificationJson Notification? @relation(fields: [notificationId], references: [id])

  @@unique([parentId])
}

model verificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model ResetPasswordToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}
