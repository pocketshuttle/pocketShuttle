{
  "id": "meshboc",
  "theme_color": "#38BDF8",
  "background_color": "#16171c",
  "display": "standalone",
  "scope": "/",
  "start_url": "/",
  "name": "PocketShuttle",
  "short_name": "pocketshuttle",
  "description": "Safety of your kids",
  "dir": "auto",
  "related_applications": [
    {
      "platform": "webapp"
    }
  ],
  "prefer_related_applications": true,
  "categories": ["kids", "productivity", "geolocation"],
  "share_target": {
    "action": "/share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "pocketshuttle",
      "text": "Safety of your kids"
    }
  },
  "display_override": ["window-controls-overlay"],
  "edge_side_panel": {
    "preferred_width": 496
  },
  "icons": [
    {
      "src": "/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-256x256.png",
      "sizes": "256x256",
      "type": "image/png"
    },
    {
      "src": "/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png"
    },
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
