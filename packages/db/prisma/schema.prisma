// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets=["native", "rhel-openssl-3.0.x"]
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ActionType {
  CREATE_SCHOOL
  DELETE_SCHOOL
  RESET_PASSWORD
  UPDATE_SUBSCRIPTION
  MODIFY_SETTINGS
}

enum NotificationType {
  PICKUP
  DROPOFF
  LOCATION_UPDATE
  SYSTEM
}

enum BusStatus {
  ENROUTE
  PARKED
}

enum StudentStatus {
  DROPPED
  PICKED
}

enum StudentAttendance {
  ABSENT
  PRESENT
}

enum StudentPresence {
  IN_BUS
  AT_SCHOOL
  ON_THE_WAY
  NONE
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum UserRole {
  ADMIN
  USER
}

model SuperUser {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("SUPERADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  actions SuperUserAction[]
}

model SuperUserAction {
  id          String    @id @default(cuid())
  superUserId String
  action      String 
  targetId    String? 
  createdAt   DateTime  @default(now())
  metadata    Json?
  superUser   SuperUser @relation(fields: [superUserId], references: [id])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          UserRole  @default(ADMIN)
  password      String?

  Subscription   Subscription[]
  NewUser        NewUser[]
  Account        Account[]
  Teacher        Teacher[]
  Driver         Driver[]
  Parent         Parent[]
  Student        Student[]
  Route          Route[]
  Buses          Buses[]
  Payment        Payment[]
  SchoolSettings SchoolSettings?
  AuditLog       AuditLog[]

  @@map("users")
}

model Plan {
  id            String         @id @default(cuid())
  name          String         @unique
  price         Float
  duration      Int // in days
  description   String?
  features      Json?
  subscriptions Subscription[]
}

model Subscription {
  id               String           @id @default(cuid())
  userId           String
  planId           String
  startDate        DateTime         @default(now())
  endDate          DateTime
  status           String           @default("ACTIVE")
  subscriptionPlan SubscriptionPlan @default(FREE)
  user             User             @relation(fields: [userId], references: [id])
  plan             Plan             @relation(fields: [planId], references: [id])
  Payment          Payment[]
}

model NewUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  schoolId  String
  school    User     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parent    Parent?  @relation(fields: [parentId], references: [id])
  parentId  String?
  userId    String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Teacher {
  id            String    @id @default(cuid())
  teacherId     String?   @map("teacher_id")
  role          String
  full_name     String?
  image         String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  password      String?
  phoneNumber   String?
  address       String
  schoolId      String?
  school        User?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  busId         String?   @unique
  bus           Buses?    @relation(fields: [busId], references: [id], onDelete: Cascade)
  NewUser       NewUser[]
  Student       Student[]
  Pickup        Pickup[]
  userId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([email, schoolId])
}

model Driver {
  id            String    @id @default(cuid())
  driverId      String?   @map("driver_id")
  full_name     String
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  phoneNumber   String?
  image         String?
  address       String
  schoolId      String?
  busId         String?   @unique
  bus           Buses?    @relation(fields: [busId], references: [id])
  school        User?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Parent {
  id            String               @id @default(cuid())
  role          String
  full_name     String?
  image         String?
  email         String?              @unique
  emailVerified DateTime?            @map("email_verified")
  password      String?
  phoneNumber   String?
  address       String?
  addressCoords Json?
  schoolId      String
  school        User                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  busId         String?
  NewUser       NewUser[]
  Student       Student[]
  notifications ParentNotification[]
  Pickup        Pickup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([schoolId])
}

model Student {
  id         String             @id @default(cuid())
  parentId   String?            @map("parent_id")
  full_name  String?
  image      String?
  grade      String?
  gender     String?
  age        Int?
  address    String?
  attendance StudentAttendance? @default(ABSENT)
  status     StudentStatus?     @default(DROPPED)
  presence   StudentPresence?   @default(NONE)
  parent     Parent?            @relation(fields: [parentId], references: [id])
  schoolId   String
  teacherId  String?
  teacher    Teacher?           @relation(fields: [teacherId], references: [id])
  school     User               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  busId      String?
  bus        Buses?             @relation("BusStudents", fields: [busId], references: [id])
  Buses      Buses[]
  Pickup     Pickup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Route {
  id                String  @id @default(cuid())
  route_name        String
  schoolId          String
  route_description String
  school            User    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  Buses             Buses[]
}

model Buses {
  id               String    @id @default(cuid())
  bus_product_name String
  bus_number       String    @unique
  seat_number      Int
  color            String?
  schoolId         String
  school           User      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  routeId          String
  studentId        String?
  students         Student[] @relation("BusStudents")
  route            Route?    @relation(fields: [routeId], references: [id])
  teacher          Teacher?
  Student          Student[]
  driver           Driver?

  @@map("buses")
}

model Notification {
  id               String               @id @default(cuid())
  notificationJson String
  parents          ParentNotification[]
}

model ParentNotification {
  id               String        @id @default(cuid())
  parentId         String?
  notificationId   String?
  parent           Parent?       @relation(fields: [parentId], references: [id])
  notificationJson Notification? @relation(fields: [notificationId], references: [id])

  @@unique([parentId])
}

model verificationToken {
  id      String   @id @default(cuid())
  email   String
  role    String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model ResetPasswordToken {
  id      String   @id @default(cuid())
  email   String
  role    String?
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Pickup {
  id          String    @id @default(cuid())
  studentId   String
  teacherId   String
  parentId    String
  pickUpTime  DateTime  @default(now())
  arrivalTime DateTime?
  confirmedBy String?

  // Relations
  Parent  Parent  @relation(fields: [parentId], references: [id])
  Student Student @relation(fields: [studentId], references: [id])
  Teacher Teacher @relation(fields: [teacherId], references: [id])
}

//FUTURE WORK FLOW
model Payment {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  amount         Float
  currency       String        @default("NGN")
  status         PaymentStatus @default(PENDING)
  transactionId  String        @unique
  createdAt      DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
}

model SchoolSettings {
  id             String   @id @default(cuid())
  schoolId       String
  pickupWindow   Int      @default(15)
  notifyDistance Int      @default(500)
  school         User     @relation(fields: [schoolId], references: [id])
  updatedAt      DateTime @updatedAt

  @@unique([schoolId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   Json?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
}
