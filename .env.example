# Copy this file to .env (and/or .env.local) and fill in real values.
# Never commit the filled-in file.

# --- Core app ---
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL_=http://localhost:3000

# --- Auth (custom JWT session, see lib/create-session.ts) ---
AUTH_SECRET=
AUTH_KEY=
JWT_SECRET=
SOCKET_AUTH_SECRET=
NEXT_PUBLIC_SOCKET_URL=
FRONTEND_ORIGIN=http://localhost:3000

# Email: driver-test@pocketshuttle.test
# Password: L2U79w950o8lDJqQzSeF!A1

# --- Database (Prisma / PostgreSQL) ---
DATABASE_URL=

# --- Distributed rate limiting (Upstash Redis) ---
# Optional in development (falls back to in-memory, single-instance-only
# rate limiting with a logged warning); required before scaling past one
# server instance in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Error tracking (Sentry) ---
# Optional: the SDK no-ops until these are set.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Cloudinary (media storage) ---
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- SMS (Twilio) ---
NEXT_PUBLIC_TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- In-app notifications (Knock) ---
KNOCK_SECRET_API_SECRET=
NEXT_PUBLIC_KNOCK_API_KEY=
NEXT_PUBLIC_KNOCK_FEED_CHANNEL_ID=

# --- Push notifications (OneSignal) ---
ONE_SIGNAL=
NEXT_PUBLIC_APP_ID=
NEXT_PUBLIC_SAFARI_ID=

# --- Realtime (Pusher, used by the standalone driver<->parent feature) ---
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# --- Maps ---
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX=
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# --- Billing (Paystack) ---
PAYSTACK_SECRET_KEY=

# --- Background jobs (Upstash QStash) ---
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
