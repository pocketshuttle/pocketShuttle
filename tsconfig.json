{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
    // "typeRoots": ["./node_modules/@types", "./packages/db/node_modules/.prisma"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "worker/index.js",
    "app/api/events/attendance-events.ts",
    "prisma/seed.mjs",
    "prisma/seed.mjs",
    "components/pick-logs/pickup-time-flow.tsx",
    "dropoff-backend/lib/db.js",
    "dropoff-backend/server.js"
  ],
  "exclude": ["node_modules"]
}
