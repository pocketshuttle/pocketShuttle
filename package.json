{
  "name": "dropoff",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "dropoff-backend"
  ],
  "scripts": {
    "dev:web": "next dev",
    "dev:backend": "npm --workspace @dropoff/backend run dev",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:backend\"",
    "build": "npx prisma generate --schema=packages/db/prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:cron": "tsx --test tests/cron/*.test.ts",
    "test:subscriptions": "tsx --test tests/subscriptions/*.test.ts",
    "test:admin": "tsx --test tests/admin/*.test.ts",
    "test:mobile": "tsx --test tests/mobile/*.test.ts",
    "test:lib": "tsx --test tests/lib/*.test.ts",
    "test": "npm run test:cron && npm run test:subscriptions && npm run test:admin && npm run test:lib && npm run test:mobile",
    "mobile:start": "npm --workspace @pocketshuttle/mobile run start",
    "mobile:android": "npm --workspace @pocketshuttle/mobile run android",
    "mobile:typecheck": "npm --workspace @pocketshuttle/mobile run typecheck",
    "qstash:sync": "tsx scripts/qstash-schedules.ts sync",
    "qstash:check": "tsx scripts/qstash-schedules.ts check",
    "qstash:remove": "tsx scripts/qstash-schedules.ts remove",
    "postinstall": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:seed": "node packages/db/prisma/seed.mjs",
    "db:seed:plans": "tsx packages/db/prisma/seed-subscription-plans.ts",
    "admin:create": "node packages/db/prisma/create-super-admin.mjs"
  },
  "prisma": {
    "seed": "node packages/db/prisma/seed.mjs",
    "schema": "packages/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@geoapify/geocoder-autocomplete": "^2.0.3",
    "@geoapify/leaflet-address-search-plugin": "^1.0.2",
    "@hookform/resolvers": "^3.7.0",
    "@knocklabs/node": "^0.6.8",
